{
  "info": {
    "_postman_id": "schooltool-collection",
    "name": "SchoolTool API",
    "description": "Collection de tests API pour le projet SchoolTool — CDA Module 3 CP9",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Promotion",
      "item": [
        {
          "name": "GET Promotion - Cas nominal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function() { pm.response.to.have.status(200); });",
                  "pm.test('Réponse est un tableau', function() { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Token", "value": "{{token}}" }],
            "url": {
              "raw": "{{base_url}}/promotion?promotion_name=",
              "host": ["{{base_url}}"],
              "path": ["promotion"],
              "query": [{ "key": "promotion_name", "value": "" }]
            }
          }
        },
        {
          "name": "GET Promotion - Sans token (pas de blocage)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Réponse 200 sans token', function() { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/promotion?promotion_name=",
              "host": ["{{base_url}}"],
              "path": ["promotion"],
              "query": [{ "key": "promotion_name", "value": "" }]
            }
          }
        },
        {
          "name": "POST Promotion - Cas nominal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function() { pm.response.to.have.status(200); });",
                  "pm.test('Retourne un ID', function() { pm.expect(pm.response.json()).to.be.a('number'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Token", "value": "{{token}}" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "promotion_name", "value": "CDA 2024" },
                { "key": "promotion_year", "value": "2024" },
                { "key": "section_id", "value": "1" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/promotion",
              "host": ["{{base_url}}"],
              "path": ["promotion"]
            }
          }
        },
        {
          "name": "POST Promotion - Champs manquants (412)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Erreur validation - 412', function() { pm.response.to.have.status(412); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Token", "value": "{{token}}" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [{ "key": "promotion_name", "value": "CDA 2024" }]
            },
            "url": {
              "raw": "{{base_url}}/promotion",
              "host": ["{{base_url}}"],
              "path": ["promotion"]
            }
          }
        }
      ]
